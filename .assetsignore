# wrangler 배포 스캔/업로드 제외 목록
# 목적: 루트의 대용량 아카이브/원본 소스 폴더(~1GB, 2000+파일)를 제외해
#       배포가 "Building list of assets..."에서 멈추지 않게 한다.
# 주의: assets/ · shared/ 는 라이브가 참조하므로 통째로 제외하지 않는다.

# 버전 아카이브 (대용량)
v1/
v3.0/
v3.1/
v3.2/
v3.2.1/
온비_v3.4/
uploads/
uploads 2/
screenshots/

# 디자인툴 원본 소스 / 런타임 (서빙 안 함)
*.dc.html
_ds/
_ds 2/
_tools/
image-slot.js
support.js
_chrome.reference.html
_ds_bundle.js

# On:Gi 잔재 스타일 (shared/ 내부, 서빙 안 함)
shared/landing.css
shared/theme.js
shared/tokens.css

# iCloud 동기화 충돌 사본
assets 2/

# 문서/설정/메타 (서빙 안 함)
*.docx
CLAUDE.md
README*
.claude/
.git/
.DS_Store
wrangler.jsonc
.assetsignore
.gitignore
package*.json

# 실험용 샌드박스
sandbox-*
